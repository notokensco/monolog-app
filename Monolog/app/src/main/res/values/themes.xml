<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Monolog" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/monolog_launch_background</item>
    </style>

    <style name="Theme.Monolog.Starting" parent="Theme.Monolog">
        <item name="android:windowSplashScreenBackground">@color/monolog_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/monolog_splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/monolog_launch_wordmark</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Monolog.Capture" parent="Theme.Monolog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
